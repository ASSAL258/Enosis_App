FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL
ARG VITE_AUTH_API_URL
ARG VITE_PROCESS_API_URL
ARG VITE_AVANCE_API_URL
ARG VITE_ATTESTATION_API_URL
ARG VITE_RIB_API_URL
ARG VITE_CONGE_API_URL
ARG VITE_PRET_API_URL
ARG VITE_FILES_API_URL

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_AUTH_API_URL=${VITE_AUTH_API_URL}
ENV VITE_PROCESS_API_URL=${VITE_PROCESS_API_URL}
ENV VITE_AVANCE_API_URL=${VITE_AVANCE_API_URL}
ENV VITE_ATTESTATION_API_URL=${VITE_ATTESTATION_API_URL}
ENV VITE_RIB_API_URL=${VITE_RIB_API_URL}
ENV VITE_CONGE_API_URL=${VITE_CONGE_API_URL}
ENV VITE_PRET_API_URL=${VITE_PRET_API_URL}
ENV VITE_FILES_API_URL=${VITE_FILES_API_URL}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
